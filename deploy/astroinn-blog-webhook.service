[Unit]
Description=Receive signed deployment notifications for Astroinn blog
Wants=network-online.target
After=network-online.target

[Service]
User=blogdeploy
Group=blogdeploy
ExecStart=/usr/bin/python3 /opt/astroinn-blog/webhook.py
LoadCredential=webhook-key:/etc/astroinn-blog/webhook-key
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/astroinn-blog/data
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
